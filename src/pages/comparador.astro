---
import BaseLayout from '../layouts/BaseLayout.astro'
import ComparadorApp from '../components/ComparadorApp'
import { getCollection } from 'astro:content'

const CAMPOS = [
  'id', 'slug', 'marca', 'modelo', 'nombre_completo', 'tipo', 'imagen',
  'cilindraje', 'potencia_hp', 'torque_nm', 'alimentacion', 'transmision', 'combustible',
  'capacidad_tanque_l', 'consumo_km_l', 'peso_kg', 'altura_asiento_mm', 'distancia_suelo_mm',
  'suspension_delantera', 'suspension_trasera', 'freno_delantero', 'freno_trasero', 'precio_cop',
]

const motos = (await getCollection('motos')).map(moto => {
  const slim = {}
  for (const campo of CAMPOS) slim[campo] = moto.data[campo]
  return slim
})

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Comparador de Motos en Colombia',
  description: 'Compara las especificaciones técnicas de hasta 3 motos lado a lado. Tabla comparativa con precio, consumo, potencia y más.',
}
---

<BaseLayout
  title="Comparador de Motos en Colombia"
  description="Compara especificaciones técnicas de motos en Colombia. Precio, cilindraje, consumo, potencia y más características lado a lado."
  canonical="/comparador"
  schema={schema}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Comparador', path: '/comparador' },
  ]}
>
  <div class="page-wrapper">
    <div class="container">
      <nav class="breadcrumbs">
        <a href="/">Inicio</a>
        <span>/</span>
        <span>Comparador</span>
      </nav>
      <div class="section-title">
        <h1>Comparador de Motos</h1>
      </div>
      <ComparadorApp client:load motos={JSON.stringify(motos)} />
    </div>
  </div>
</BaseLayout>
